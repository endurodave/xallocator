{
  "name": "xallocator",
  "version": "1.3.0",
  "description": "Fast fixed block memory allocator replacing malloc/free and new/delete. Prevents heap fragmentation; thread-safe; optional static pools for heap-free embedded systems.",
  "keywords": [
    "allocator",
    "memory",
    "memory pool",
    "fixed block",
    "malloc",
    "heap",
    "embedded",
    "cpp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/endurodave/xallocator.git"
  },
  "authors": [
    {
      "name": "David Lafreniere",
      "url": "https://github.com/endurodave",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/endurodave/xallocator",
  "frameworks": "*",
  "platforms": "*",
  "headers": "xallocator.h",
  "dependencies": [
    {
      "owner": "endurodave",
      "name": "Allocator",
      "version": "^1.2.0"
    }
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "LICENSE",
      "README.md",
      "library.json",
      "library.properties"
    ],
    "exclude": [
      "**/.pio",
      "**/.pio/**"
    ]
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  },
  "examples": [
    {
      "name": "xallocator-demo",
      "base": "examples/platformio/xallocator-demo",
      "files": [
        "platformio.ini",
        "src/main.cpp"
      ]
    },
    {
      "name": "xallocator_Demo",
      "base": "examples/xallocator_Demo",
      "files": [
        "xallocator_Demo.ino"
      ]
    }
  ]
}
